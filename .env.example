# Jetons Discord (Portail développeur > Bot > Reset Token)
# BOT 1 = Commu Dream, le bot du quotidien
BOT1_TOKEN=
# BOT 2 = Dream Protect, sécurité et configuration
BOT2_TOKEN=

# Owners du bot (accès total), séparés par des virgules
OWNER_IDS=

# Serveurs où publier les commandes slash tout de suite (vide = partout, 1 h de délai)
REGISTER_GUILD_ID=

# Base de données (vide = data/dream.sqlite)
DATABASE_PATH=

# Sauvegarde automatique, en minutes (15 minimum)
BACKUP_MINUTES=30
